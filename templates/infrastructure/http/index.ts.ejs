export const mockUtils = {
  /**
   * Create mock response
   */
  createMockResponse<T>(data: T, status: number = 200): ApiResponse<T> {
    return {
      data,
      status,
      statusText: 'OK',
      headers: {},
      success: true,
      message: 'Mock response'
    };
  },

  /**
   * Create mock error response
   */
  createMockError(message: string, status: number = 400): ErrorResponse {
    return {
      success: false,
      message,
      error: {
        code: `MOCK_ERROR_${status}`,
        message
      },
      timestamp: new Date().toISOString()
    };
  },

  /**
   * Simulate network delay
   */
  delay(ms: number = 500): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
};
