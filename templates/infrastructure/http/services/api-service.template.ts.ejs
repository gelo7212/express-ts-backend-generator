    const url = `<%- path %>`;
    
    <%_ if (isGetMethod) { _%>
    return this.httpClient.get(url, {
      <%_ if (methodName.includes('getAll') || (!endpoint.path.includes(':id') && !endpoint.path.includes('{id}'))) { _%>
      params,
      <%_ } _%>
      ...options
