    <%_ } else if (isPostMethod) { _%>
    return this.httpClient.post(url, data, options);
    <%_ } else if (isPutMethod) { _%>
    return this.httpClient.put(url, data, options);
    <%_ } else if (isPatchMethod) { _%>
